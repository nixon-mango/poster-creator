# Docker Environment Configuration for Jaaz
# Copy this file to .env and modify values as needed

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME=jaaz
APP_VERSION=1.0.29
NODE_ENV=production

# ===========================================
# BACKEND SETTINGS
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=57988
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Path to React build directory
UI_DIST_DIR=/home/jaaz/react/dist

# ===========================================
# FRONTEND SETTINGS
# ===========================================
FRONTEND_PORT=80
FRONTEND_HOST=0.0.0.0

# ===========================================
# DATABASE SETTINGS (if using PostgreSQL)
# ===========================================
# DATABASE_URL=postgresql://jaaz:jaaz_password@postgres:5432/jaaz
# POSTGRES_DB=jaaz
# POSTGRES_USER=jaaz
# POSTGRES_PASSWORD=jaaz_password

# ===========================================
# REDIS SETTINGS
# ===========================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===========================================
# AI SERVICES CONFIGURATION
# ===========================================
# OpenAI Configuration
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration  
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (for local AI models)
# OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini Configuration
# GOOGLE_API_KEY=your_google_api_key_here

# ===========================================
# SECURITY SETTINGS
# ===========================================
# JWT Secret for session management
# JWT_SECRET_KEY=your_jwt_secret_key_here

# CORS Settings
CORS_ORIGINS=http://localhost:80,http://localhost:3000,http://localhost:5174

# ===========================================
# LOGGING SETTINGS
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/home/jaaz/logs/app.log

# ===========================================
# STORAGE SETTINGS
# ===========================================
# Data directory for persistent storage
DATA_DIR=/home/jaaz/data
UPLOAD_DIR=/home/jaaz/data/uploads
WORKSPACE_DIR=/home/jaaz/data/workspaces

# Maximum file upload size (in bytes)
MAX_UPLOAD_SIZE=104857600  # 100MB

# ===========================================
# WEBSOCKET SETTINGS
# ===========================================
WEBSOCKET_PATH=/socket.io
WEBSOCKET_CORS_ALLOWED_ORIGINS=*

# ===========================================
# DEVELOPMENT SETTINGS (for development override)
# ===========================================
# Uncomment for development mode
# NODE_ENV=development
# DEBUG=true
# HOT_RELOAD=true